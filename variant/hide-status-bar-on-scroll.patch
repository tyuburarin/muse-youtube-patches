@@ -423,6 +430,50 @@ public final class HideStatusBarPatch {
         }
     }
 
+    /**
+     * Called by {@link NavigationBarPatch} on the main thread when it hides or shows
+     * the navigation bar while a list is scrolling, so the status bar follows it.
+     * Does nothing if the status bar is always hidden, as it then stays hidden.
+     *
+     * @param view Any view of the window whose status bar is hidden or shown.
+     * @param hide If the status bar is hidden.
+     */
+    public static void setStatusBarHiddenOnScroll(@Nullable View view, boolean hide) {
+        if (!HIDE_STATUS_BAR_ON_SCROLL || HIDE_STATUS_BAR) {
+            return;
+        }
+        // Not skipped if the state is unchanged: the app can show the status bar
+        // again on its own (for example after fullscreen), so the call re-applies it.
+        statusBarHiddenOnScroll = hide;
+        if (view == null) {
+            return;
+        }
+
+        try {
+            View decorView = view.getRootView();
+            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.R) {
+                WindowInsetsController controller = decorView.getWindowInsetsController();
+                if (controller != null) {
+                    if (hide) {
+                        controller.setSystemBarsBehavior(
+                                WindowInsetsController.BEHAVIOR_SHOW_TRANSIENT_BARS_BY_SWIPE);
+                        controller.hide(WindowInsets.Type.statusBars());
+                    } else {
+                        controller.show(WindowInsets.Type.statusBars());
+                    }
+                }
+            } else if (hide) {
+                decorView.setSystemUiVisibility(decorView.getSystemUiVisibility()
+                        | View.SYSTEM_UI_FLAG_FULLSCREEN);
+            } else {
+                decorView.setSystemUiVisibility(decorView.getSystemUiVisibility()
+                        & ~View.SYSTEM_UI_FLAG_FULLSCREEN);
+            }
+        } catch (Exception ex) {
+            Logger.printException(() -> "setStatusBarHiddenOnScroll failure", ex);
+        }
+    }
+
     /**
      * The app shows the status bar again after fullscreen and some dialogs,
      * so it is hidden again whenever the window is laid out with it visible.
